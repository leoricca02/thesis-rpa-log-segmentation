# Copy this file to `.env` and fill in your own key.
# `.env` is git-ignored and must never be committed.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Gemini 3.6 Flash is the current model. Every result reported in
# Chapter 7 of the thesis, and the committed cache, used gemini-3.5-flash:
# set that value to reproduce them offline.
GEMINI_MODEL=gemini-3.6-flash
